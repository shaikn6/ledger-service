# Required
DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger?sslmode=disable

# Optional (defaults shown)
LEDGER_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s
REQUEST_TIMEOUT=10s
DB_MAX_CONNS=10
DB_MIN_CONNS=0

# Optional: comma-separated bearer tokens. When set, every /v1 request must send
# `Authorization: Bearer <token>`. When empty, the /v1 surface is open.
LEDGER_API_TOKENS=
